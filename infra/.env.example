# Database defaults
ORDER_DB_ROOT_PASSWORD=change-me-order-db
ORDER_DB_USER=order_app
ORDER_DB_PASSWORD=change-me-order-app
ORDER_DB_NAME=order_platform
ORDER_DB_PORT=3306

ADAPTER_DB_ROOT_PASSWORD=change-me-adapter-db
ADAPTER_DB_USER=adapter_app
ADAPTER_DB_PASSWORD=change-me-adapter-app
ADAPTER_DB_NAME=adapter_local
ADAPTER_DB_PORT=3307

# Service integration
APP_FEIGN_ERP_ADAPTER_URL=http://erp-adapter:8080
APP_FRONTEND_ORIGIN=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Security
APP_JWT_SECRET=replace-with-a-private-random-secret
APP_JWT_EXPIRATION_MS=18000000
SERVER_SSL_ENABLED=false

# Frontend runtime
REACT_APP_API_BASE_URL=http://localhost:9090/api
REACT_APP_WS_BASE_URL=http://localhost:9090

# ERP ODBC (required only when enabling profile: erp)
APP_ERP_ODBC_DRIVER_CLASS_NAME=replace-with-your-odbc-driver-class
APP_ERP_ODBC_URL=replace-with-your-private-erp-connection-url
APP_ERP_ODBC_USERNAME=replace-with-your-erp-username
APP_ERP_ODBC_PASSWORD=replace-with-your-erp-password
